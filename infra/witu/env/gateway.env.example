# WITU AI gateway v2 (phase B), installed to /opt/witu-gateway/.env (640 witu-deploy:witu-gw).
# No secrets here: keys, pepper and the management-token digests live in GATEWAY_SECRETS_PATH.
# APP_KEY is generated by install-gateway.sh.
APP_NAME="WITU AI Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ai.witulibrary.org
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/witu-gateway/gateway.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

GATEWAY_SECRETS_PATH=/etc/witu-gateway/secrets
GATEWAY_WORKER_LOCK=/run/witu-gateway/worker.lock
GATEWAY_HOST_ID=witulibrary
# The Let's Encrypt key directory is root-only; certificate expiry shows as Unknown in phase B.
GATEWAY_TLS_CERT_PATH=
# Apache only listens on 127.0.0.1:8081 for the management surface; this is defence in depth.
GATEWAY_MGMT_ALLOWED_IPS=127.0.0.1,::1
GATEWAY_ALLOW_ANY_SURFACE=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_THREAD=2
OLLAMA_KEEP_ALIVE=30m

# systemd units shown on Server & alerts; inactive/failed opens a service_down alert.
GATEWAY_MONITORED_SERVICES=ollama,mariadb,apache2,php8.4-fpm,witu-ai-gateway,witu-gateway-worker,witu-gateway-scheduler
