# WITU AI CMS — production .env TEMPLATE for /var/www/witu-ai/.env (ai.witulibrary.org)
# Variable names are exactly those the code reads (cms/.env.example, cms/config/*).
# Placeholders in <angle brackets> are filled on the server; never commit the real file.
# Owner/mode on the server: witu-deploy:witu-cms 640 (set by witu-deploy-cms).

APP_NAME="WITU AI"
APP_ENV=production
# Generated once on the server (runbook step 5); never regenerate on a live system:
# it invalidates sessions and anything encrypted (2FA secrets, encrypted session payloads).
APP_KEY=
APP_DEBUG=false
APP_URL=https://ai.witulibrary.org
# Stored/exchanged times stay UTC (config/app.php timezone); the portal displays Kampala time.
APP_DISPLAY_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Apache talks to PHP-FPM directly on the same host: no proxy in front of PHP.
TRUSTED_PROXIES=

# MariaDB 10.11 on localhost (values from /root/witu-ai-db.credentials, setup-mariadb.sh)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=witu_ai
DB_USERNAME=witu_ai_user
# set from /root/witu-ai-db.credentials (runbook step 5)
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing in the CMS is queued today (no ShouldQueue classes), so no queue worker runs.
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP for invitations, password resets and alert e-mails (WITU mail provider).
MAIL_MAILER=smtp
MAIL_SCHEME=null
# e.g. mail.witulibrary.org (port 465, MAIL_SCHEME=smtps)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
# keep in double quotes: MAIL_PASSWORD="..."
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@witulibrary.org"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway management API. The repo's gateway (v2) will listen on a localhost-only Apache
# vhost (ADR 0002, phase B). Until it is installed the CMS shows "Gateway unreachable" on
# gateway-backed pages instead of inventing data. The legacy FastAPI gateway has no
# management API, so it cannot be used here.
GATEWAY_MGMT_URL=http://127.0.0.1:8081/internal/v1
# phase B: output of `php8.4 artisan gateway:secrets mgmt-token`
GATEWAY_MGMT_TOKEN=
CMS_ASSERTION_SECRET_KEY_PATH=/etc/witu-ai/secrets/cms_assertion.key
CMS_ASSERTION_KID=cms-1

CMS_FEATURE_OVERVIEW=true
CMS_FEATURE_API_KEYS=true
CMS_FEATURE_MODELS_TASKS=true
CMS_FEATURE_JOBS=true
CMS_FEATURE_USAGE=true
CMS_FEATURE_HEALTH=true
CMS_FEATURE_SETTINGS=true
CMS_FEATURE_PROJECT_KEYS_TAB=true
CMS_FEATURE_PROJECT_JOBS_TAB=true
CMS_FEATURE_PROJECT_USAGE_TAB=true

SEED_PROJECT_UUIDS=
VITE_APP_NAME="${APP_NAME}"
