# Single inference worker (ADR D7). Exactly one instance; the flock in
# gateway:work refuses a second copy even if this unit is duplicated.
[Unit]
Description=Unihub AI gateway inference worker
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=unihub-gw
Group=unihub-gw
WorkingDirectory=/opt/unihub-gateway/current
ExecStart=/usr/bin/php8.4 artisan gateway:work --max-time=3600
# Restart hourly (max-time) and on crash; lease recovery runs at every start.
Restart=always
RestartSec=5
# SIGTERM → finish current job (≤ inference deadline) then exit.
KillSignal=SIGTERM
TimeoutStopSec=150
RuntimeDirectory=unihub-gateway
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=GATEWAY_WORKER_LOCK=/run/unihub-gateway/worker.lock

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/unihub-gateway /opt/unihub-gateway/shared/storage /run/unihub-gateway
ReadOnlyPaths=/etc/unihub-gateway
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
