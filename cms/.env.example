# Unihub AI staff portal (CMS). Copy to .env and fill in. Never commit .env.

APP_NAME="Unihub AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.example.org
# Stored and exchanged times are UTC; the portal displays them in this zone.
APP_DISPLAY_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Comma-separated proxy IPs if TLS is terminated in front of PHP (leave empty otherwise).
TRUSTED_PROXIES=

# MariaDB (cPanel). Tests use in-memory SQLite (see phpunit.xml).
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Database sessions so staff sessions can be listed and revoked.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# cPanel SMTP (invitations, password resets, alert e-mails).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway management API (docs/api/management-auth.md).
# URL includes the /internal/v1 prefix of the management vhost.
GATEWAY_MGMT_URL=https://mgmt-ai.kemmytech.com/internal/v1
# Issued once by `php artisan gateway:mgmt-token` on the gateway.
GATEWAY_MGMT_TOKEN=
# File written by `php artisan cms:assertion-keypair <path>`; must be OUTSIDE public/.
CMS_ASSERTION_SECRET_KEY_PATH=
CMS_ASSERTION_KID=cms-1

# Module feature flags (all built; set to false to hide a module and 404 its routes).
CMS_FEATURE_OVERVIEW=true
CMS_FEATURE_API_KEYS=true
CMS_FEATURE_MODELS_TASKS=true
CMS_FEATURE_JOBS=true
CMS_FEATURE_USAGE=true
CMS_FEATURE_HEALTH=true
CMS_FEATURE_SETTINGS=true
CMS_FEATURE_PROJECT_KEYS_TAB=true
CMS_FEATURE_PROJECT_JOBS_TAB=true
CMS_FEATURE_PROJECT_USAGE_TAB=true

# Local seeding only: gateway staging project UUIDs to attach synthetic memberships to.
SEED_PROJECT_UUIDS=

VITE_APP_NAME="${APP_NAME}"
