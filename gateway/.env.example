# Unihub gateway — example environment. No secrets belong in this file:
# keys/pepper/tokens live in GATEWAY_SECRETS_PATH (see `php artisan gateway:secrets init`).
APP_NAME="Unihub AI Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ai.kemmytech.com
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/unihub-gateway/gateway.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

GATEWAY_SECRETS_PATH=/etc/unihub-gateway/secrets
GATEWAY_WORKER_LOCK=/run/unihub-gateway/worker.lock
GATEWAY_HOST_ID=frappe-linux-1
GATEWAY_TLS_CERT_PATH=/etc/letsencrypt/live/ai.kemmytech.com/cert.pem
# Optional app-level allowlist for the management surface (nginx is the primary control)
GATEWAY_MGMT_ALLOWED_IPS=
# Local development only: allow both surfaces without nginx's GATEWAY_SURFACE param
GATEWAY_ALLOW_ANY_SURFACE=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_THREAD=2
OLLAMA_KEEP_ALIVE=30m
